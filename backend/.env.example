# Environment variables for ILMS Backend
NODE_ENV=development
PORT=5000

# Database Connection (PostgreSQL Supabase / Neon / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ilms_db?schema=public"

# Security & JWT
JWT_SECRET="ilms_super_secret_jwt_access_token_key_2026"
JWT_EXPIRES_IN="1d"
REFRESH_SECRET="ilms_super_secret_jwt_refresh_token_key_2026"
REFRESH_EXPIRES_IN="7d"

# CORS
# Lokal: comma-separated daftar origin yang diizinkan.
# Produksi (Vercel): CORS_ORIGIN="https://ilms.saiasyap.my.id"
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# IoT Settings
IOT_OFFLINE_THRESHOLD_MINUTES=2
SENSOR_RETENTION_DAYS=30

# Frontend (dipakai untuk membuat URL QR Code label inventaris)
FRONTEND_URL="http://localhost:5173"

# Automated Testing (database terpisah, JANGAN pakai ilms_db)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ilms_test?schema=public"

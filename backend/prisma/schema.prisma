generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id           String                  @id @default(uuid())
  roleId       String                  @map("role_id")
  fullName     String                  @map("full_name") @db.VarChar(100)
  email        String                  @unique @db.VarChar(100)
  username     String                  @unique @db.VarChar(50)
  nim          String?                 @unique @map("nim") @db.VarChar(20)
  passwordHash String                  @map("password_hash") @db.VarChar(255)
  phone        String?                 @db.VarChar(20)
  photoUrl     String?                 @map("photo_url") @db.VarChar(255)
  isActive     Boolean                 @default(true) @map("is_active")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?               @map("deleted_at")

  role         Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  loans        Loan[]                  @relation("UserLoans")
  approvedLoans Loan[]                 @relation("ApprovedLoans")
  stockHistory ComponentStockHistory[]
  notifications Notification[]
  auditLogs    AuditLog[]
  tickets      Ticket[]                @relation("UserTickets")
  assignedTickets Ticket[]              @relation("AssignedTickets")
  ticketMessages TicketMessage[]        @relation("TicketMessages")
  authoredProjects Project[]            @relation("AuthoredProjects")
  createdProjects  Project[]            @relation("CreatedProjects")

  @@index([roleId], map: "idx_users_role_id")
  @@index([email], map: "idx_users_email")
  @@index([username], map: "idx_users_username")
  @@index([nim], map: "idx_users_nim")
  @@map("users")
}

model Category {
  id          String      @id @default(uuid())
  name        String      @unique @db.VarChar(50)
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  components  Component[]

  @@map("categories")
}

enum ComponentCondition {
  Good
  Damaged
  Under_Repair @map("Under Repair")
}

enum ComponentStatus {
  Active
  Inactive
}

model Component {
  id             String                 @id @default(uuid())
  categoryId     String                 @map("category_id")
  name           String                 @db.VarChar(100)
  inventoryCode  String                 @unique @map("inventory_code") @db.VarChar(50)
  description    String?
  stockTotal     Int                    @default(0) @map("stock_total")
  stockAvailable Int                    @default(0) @map("stock_available")
  condition      ComponentCondition     @default(Good)
  location       String?                @db.VarChar(100)
  purchaseDate   DateTime?              @map("purchase_date") @db.Date
  estimatedPrice Decimal?               @map("estimated_price") @db.Decimal(12, 2)
  photoUrl       String?                @map("photo_url") @db.VarChar(255)
  status         ComponentStatus        @default(Active)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime?              @map("deleted_at")

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  loanDetails    LoanDetail[]
  stockHistory   ComponentStockHistory[]

  @@index([categoryId], map: "idx_components_category_id")
  @@index([name], map: "idx_components_name")
  @@index([inventoryCode], map: "idx_components_inventory_code")
  @@map("components")
}

enum TransactionType {
  IN
  OUT
  BORROWED
  RETURNED
  DAMAGED
  REPAIRED
  ADJUSTMENT
}

model ComponentStockHistory {
  id              String          @id @default(uuid())
  componentId     String          @map("component_id")
  userId          String          @map("user_id")
  transactionType TransactionType @map("transaction_type")
  quantity        Int
  stockBefore     Int             @map("stock_before")
  stockAfter      Int             @map("stock_after")
  referenceType   String?         @map("reference_type") @db.VarChar(50)
  referenceId     String?         @map("reference_id")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")

  component       Component       @relation(fields: [componentId], references: [id], onDelete: Restrict)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([componentId], map: "idx_stock_history_component_id")
  @@index([createdAt], map: "idx_stock_history_created_at")
  @@map("component_stock_history")
}

enum LoanStatus {
  Pending
  Approved
  Borrowed
  Returned
  Rejected
  Overdue
  Cancelled
}

model Loan {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  approvedBy String?      @map("approved_by")
  loanDate   DateTime     @map("loan_date") @db.Date
  dueDate    DateTime     @map("due_date") @db.Date
  returnDate DateTime?    @map("return_date") @db.Date
  status     LoanStatus   @default(Pending)
  notes      String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at")

  user       User         @relation("UserLoans", fields: [userId], references: [id], onDelete: Restrict)
  approver   User?        @relation("ApprovedLoans", fields: [approvedBy], references: [id], onDelete: SetNull)
  details    LoanDetail[]

  @@index([userId], map: "idx_loans_user_id")
  @@index([status], map: "idx_loans_status")
  @@index([dueDate], map: "idx_loans_due_date")
  @@map("loans")
}

enum DetailCondition {
  Good
  Damaged
}

model LoanDetail {
  id              String           @id @default(uuid())
  loanId          String           @map("loan_id")
  componentId     String           @map("component_id")
  quantity        Int
  conditionBefore DetailCondition  @default(Good) @map("condition_before")
  conditionAfter  DetailCondition? @map("condition_after")
  damageNotes     String?          @map("damage_notes")

  loan            Loan             @relation(fields: [loanId], references: [id], onDelete: Cascade)
  component       Component        @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([loanId], map: "idx_loan_details_loan_id")
  @@index([componentId], map: "idx_loan_details_component_id")
  @@map("loan_details")
}

enum DeviceStatus {
  Online
  Offline
  Maintenance
}

model Device {
  id              String          @id @default(uuid())
  deviceName      String          @map("device_name") @db.VarChar(100)
  deviceType      String          @map("device_type") @db.VarChar(50)
  esp32Id         String          @unique @map("esp32_id") @db.VarChar(100)
  apiKeyHash      String          @map("api_key_hash") @db.VarChar(255)
  ipAddress       String?         @map("ip_address") @db.VarChar(45)
  firmwareVersion String?         @map("firmware_version") @db.VarChar(20)
  location        String?         @db.VarChar(100)
  status          DeviceStatus    @default(Offline)
  lastSeen        DateTime?       @map("last_seen")
  registeredAt    DateTime        @default(now()) @map("registered_at")

  readings        SensorReading[]

  @@index([esp32Id], map: "idx_devices_esp32_id")
  @@index([status], map: "idx_devices_status")
  @@map("devices")
}

model SensorReading {
  id         String   @id @default(uuid())
  deviceId   String   @map("device_id")
  sensorType String   @map("sensor_type") @db.VarChar(50)
  value      Decimal  @db.Decimal(10, 2)
  unit       String?  @db.VarChar(20)
  recordedAt DateTime @default(now()) @map("recorded_at")

  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt], map: "idx_sensor_readings_device_time")
  @@map("sensor_readings")
}

model Project {
  id               String    @id @default(uuid())
  title            String    @db.VarChar(150)
  category         String    @db.VarChar(50)
  description      String
  techStack        String?   @map("tech_stack") @db.VarChar(255)
  repoUrl          String?   @map("repo_url") @db.VarChar(255)
  demoUrl          String?   @map("demo_url") @db.VarChar(255)
  imageUrl         String?   @map("image_url") @db.VarChar(255)
  year             String?   @db.VarChar(10)
  tags             String[]  @default([])
  highlights       String[]  @default([])
  isStudentProject Boolean   @default(false) @map("is_student_project")
  authorId         String?   @map("author_id")
  authorName       String    @map("author_name") @db.VarChar(100)
  authorRole       String?   @map("author_role") @db.VarChar(50)
  authorNim        String?   @map("author_nim") @db.VarChar(20)
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  author    User? @relation("AuthoredProjects", fields: [authorId], references: [id], onDelete: SetNull)
  createdBy User? @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isStudentProject], map: "idx_projects_is_student")
  @@index([deletedAt], map: "idx_projects_deleted_at")
  @@index([category], map: "idx_projects_category")
  @@map("projects")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(150)
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum TicketStatus {
  Open
  In_Progress @map("In Progress")
  Resolved
  Closed
}

enum TicketPriority {
  Low
  Medium
  High
  Urgent
}

model Ticket {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  subject   String        @db.VarChar(150)
  status    TicketStatus  @default(Open)
  priority  TicketPriority @default(Medium)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")
  closedAt  DateTime?     @map("closed_at")
  assignedTo String?      @map("assigned_to")
  deletedAt DateTime?     @map("deleted_at")

  user      User          @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignee  User?         @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages  TicketMessage[]

  @@index([userId], map: "idx_tickets_user_id")
  @@index([status], map: "idx_tickets_status")
  @@index([priority], map: "idx_tickets_priority")
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  senderId  String   @map("sender_id")
  message   String
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User     @relation("TicketMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "idx_ticket_messages_ticket_id")
  @@index([createdAt], map: "idx_ticket_messages_created_at")
  @@map("ticket_messages")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([userId], map: "idx_audit_logs_user_id")
  @@map("audit_logs")
}

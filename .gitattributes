# Normalisasi line ending agar diff antar-platform tidak berantakan
* text=auto eol=lf

# File yang wajib LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.md text eol=lf

# File yang wajib CRLF (Windows)
*.bat text eol=crlf
*.ps1 text eol=crlf

# File binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary
